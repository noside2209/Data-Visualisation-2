{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Australian Open Attendance (2000–2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_history.csv"
  },
  "layer": [
    {
      "mark": {"type": "area", "color": "#00aeef", "opacity": 0.7},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -45}},
        "y": {"field": "attendance", "type": "quantitative", "title": "Total Attendance", "axis": {"format": ",.0f"}},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "attendance", "type": "quantitative", "title": "Attendance", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#ff6b35", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2021"}}
    },
    {
      "mark": {"type": "text", "color": "#ff6b35", "align": "left", "dx": 5, "dy": -80, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2021"},
        "text": {"value": "COVID restrictions"}
      }
    },
    {
      "mark": {"type": "rule", "color": "#00aeef", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2025"}}
    },
    {
      "mark": {"type": "text", "color": "#00aeef", "align": "right", "dx": -5, "dy": -80, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2025"},
        "text": {"value": "Record 1.2M attendance"}
      }
    }
  ]
}