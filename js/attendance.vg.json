{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Australian Open Attendance (2000–2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_history.csv"
  },
  "mark": {"type": "area", "color": "#1a78c2", "opacity": 0.7},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "attendance",
      "type": "quantitative",
      "title": "Total Attendance",
      "axis": {"format": ","}
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "attendance", "type": "quantitative", "title": "Attendance", "format": ","}
    ]
  }
}