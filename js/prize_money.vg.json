{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 300,
  "title": "Australian Open Prize Money Growth (2000–2026)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_history.csv"
  },
  "layer": [
    {
      "mark": {"type": "line", "point": true, "color": "#1a78c2"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -45}},
        "y": {
          "field": "prize_money_aud",
          "type": "quantitative",
          "title": "Total Prize Money (AUD)",
          "axis": {"format": "$,.0f"}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "prize_money_aud", "type": "quantitative", "title": "Prize Money (AUD)", "format": "$,.0f"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#ff6b35", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2021"}}
    },
    {
      "mark": {"type": "text", "color": "#ff6b35", "align": "left", "dx": 5, "dy": -60, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2021"},
        "text": {"value": "COVID-19"}
      }
    },
    {
      "mark": {"type": "rule", "color": "#00aeef", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2015"}}
    },
    {
      "mark": {"type": "text", "color": "#00aeef", "align": "left", "dx": 5, "dy": -80, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2015"},
        "text": {"value": "First $40M purse"}
      }
    },
    {
      "mark": {"type": "rule", "color": "#ffd700", "strokeDash": [4, 4]},
      "encoding": {"x": {"datum": "2026"}}
    },
    {
      "mark": {"type": "text", "color": "#ffd700", "align": "right", "dx": -5, "dy": -100, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2026"},
        "text": {"value": "First $100M+"}
      }
    }
  ]
}