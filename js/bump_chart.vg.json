{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 300,
  "title": "Top Nations by Australian Open Titles Per Decade",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_atp.csv"
  },
  "transform": [
    {"filter": "datum.round == 'F'"},
    {
      "calculate": "datum.tourney_date < 20100000 ? '2000s' : datum.tourney_date < 20200000 ? '2010s' : '2020s'",
      "as": "decade"
    },
    {
      "aggregate": [{"op": "count", "as": "titles"}],
      "groupby": ["winner_ioc", "decade"]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "titles", "order": "descending"}],
      "groupby": ["decade"]
    },
    {"filter": "datum.rank <= 5"},
    {
      "calculate": "datum.winner_ioc == 'ESP' ? 'Spain' : datum.winner_ioc == 'SRB' ? 'Serbia' : datum.winner_ioc == 'SUI' ? 'Switzerland' : datum.winner_ioc == 'RUS' ? 'Russia' : datum.winner_ioc == 'USA' ? 'United States' : datum.winner_ioc == 'ITA' ? 'Italy' : datum.winner_ioc == 'SWE' ? 'Sweden' : datum.winner_ioc == 'AUS' ? 'Australia' : datum.winner_ioc == 'GER' ? 'Germany' : datum.winner_ioc",
      "as": "country_name"
    }
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Decade"
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Rank",
      "scale": {"domain": [1, 2, 3, 4, 5]}
    },
    "color": {
      "field": "country_name",
      "type": "nominal",
      "title": "Country"
    },
    "tooltip": [
      {"field": "country_name", "type": "nominal", "title": "Country"},
      {"field": "decade", "type": "ordinal", "title": "Decade"},
      {"field": "rank", "type": "ordinal", "title": "Rank"},
      {"field": "titles", "type": "quantitative", "title": "Titles"}
    ]
  }
}