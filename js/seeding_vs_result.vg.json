{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": "Do Higher Seeds Go Further? Seeding vs Round Reached (2000–2026)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_atp.csv"
  },
  "transform": [
    {"filter": "datum.winner_seed != '' && datum.winner_seed != null"},
    {"calculate": "toNumber(datum.winner_seed)", "as": "seed_num"},
    {"filter": "datum.seed_num <= 8"},
    {
      "calculate": "datum.round == 'F' ? 7 : datum.round == 'SF' ? 6 : datum.round == 'QF' ? 5 : datum.round == 'R16' ? 4 : datum.round == 'R32' ? 3 : datum.round == 'R64' ? 2 : 1",
      "as": "round_num"
    },
    {
      "aggregate": [{"op": "mean", "field": "round_num", "as": "avg_round"}],
      "groupby": ["seed_num"]
    },
    {"calculate": "0", "as": "zero"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#1a78c2", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "seed_num", "type": "ordinal", "title": "Seeding"},
        "y": {"field": "zero", "type": "quantitative", "title": "Average Round Reached",
          "axis": {
            "values": [1, 2, 3, 4, 5, 6, 7],
            "labelExpr": "datum.value == 1 ? 'R128' : datum.value == 2 ? 'R64' : datum.value == 3 ? 'R32' : datum.value == 4 ? 'R16' : datum.value == 5 ? 'QF' : datum.value == 6 ? 'SF' : 'Final'"
          }
        },
        "y2": {"field": "avg_round"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 150, "color": "#00aeef"},
      "encoding": {
        "x": {"field": "seed_num", "type": "ordinal", "title": "Seeding"},
        "y": {
          "field": "avg_round",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "seed_num", "type": "ordinal", "title": "Seeding"},
          {"field": "avg_round", "type": "quantitative", "title": "Avg Round", "format": ".2f"}
        ]
      }
    }
  ]
}