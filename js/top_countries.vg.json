{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Top 10 Countries by Australian Open Player Appearances (2000–2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_atp.csv"
  },
  "transform": [
    {
      "fold": ["winner_ioc", "loser_ioc"],
      "as": ["role", "country"]
    },
    {
      "aggregate": [{"op": "count", "as": "appearances"}],
      "groupby": ["country"]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "appearances", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"}
  ],
  "mark": {"type": "bar", "color": "#1a78c2"},
  "encoding": {
    "x": {
      "field": "appearances",
      "type": "quantitative",
      "title": "Total Appearances"
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": "-x",
      "title": "Country"
    },
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country"},
      {"field": "appearances", "type": "quantitative", "title": "Appearances"}
    ]
  }
}