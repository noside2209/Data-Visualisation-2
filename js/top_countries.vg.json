{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Top 10 Countries by Australian Open Player Appearances (2000–2026)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_atp.csv"
  },
  "transform": [
    {"fold": ["winner_ioc", "loser_ioc"], "as": ["role", "ioc"]},
    {"aggregate": [{"op": "count", "as": "appearances"}], "groupby": ["ioc"]},
    {
      "calculate": "datum.ioc == 'USA' ? 'United States' : datum.ioc == 'ESP' ? 'Spain' : datum.ioc == 'FRA' ? 'France' : datum.ioc == 'AUS' ? 'Australia' : datum.ioc == 'GER' ? 'Germany' : datum.ioc == 'ARG' ? 'Argentina' : datum.ioc == 'RUS' ? 'Russia' : datum.ioc == 'ITA' ? 'Italy' : datum.ioc == 'CZE' ? 'Czech Republic' : datum.ioc == 'SRB' ? 'Serbia' : datum.ioc",
      "as": "country_name"
    },
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "appearances", "order": "descending"}]},
    {"filter": "datum.rank <= 10"}
  ],
  "mark": {"type": "bar"},
  "encoding": {
    "x": {"field": "appearances", "type": "quantitative", "title": "Total Appearances"},
    "y": {"field": "country_name", "type": "nominal", "sort": "-x", "title": "Country"},
    "color": {"field": "appearances", "type": "quantitative", "scale": {"scheme": "blues"}, "legend": null},
    "tooltip": [
      {"field": "country_name", "type": "nominal", "title": "Country"},
      {"field": "appearances", "type": "quantitative", "title": "Appearances"}
    ]
  }
}