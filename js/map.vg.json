{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 350,
  "title": "Australian Open Player Origins by Year",
  "projection": {"type": "equalEarth"},
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2026,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e0e0e0", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/country_appearances_by_year.csv"
      },
      "transform": [
        {"filter": "datum.year == year_select"},
        {
          "lookup": "iso",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
              "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.ISO_A3",
            "fields": ["properties.NAME", "type", "geometry"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "shape": {"field": "geometry", "type": "geojson"},
        "color": {
          "field": "appearances",
          "type": "quantitative",
          "scale": {"scheme": "blues", "domain": [0, 50]},
          "legend": {"title": "Appearances"}
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "appearances", "type": "quantitative", "title": "Appearances"},
          {"field": "year", "type": "ordinal", "title": "Year"}
        ]
      }
    }
  ]
}