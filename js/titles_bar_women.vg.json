{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 200,
  "title": "Most Australian Open Singles Titles (Women, 2000–2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_history.csv"
  },
  "transform": [
    {"aggregate": [{"op": "count", "as": "titles"}], "groupby": ["womens_winner"]},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "titles", "order": "descending"}]},
    {"filter": "datum.rank <= 5"}
  ],
  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "x": {"field": "titles", "type": "quantitative", "title": "Number of Titles"},
        "y": {"field": "womens_winner", "type": "nominal", "sort": "-x", "title": "Player"},
        "color": {"field": "titles", "type": "quantitative", "scale": {"scheme": "purplered"}, "legend": null},
        "tooltip": [
          {"field": "womens_winner", "type": "nominal", "title": "Player"},
          {"field": "titles", "type": "quantitative", "title": "Titles"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5},
      "encoding": {
        "x": {"field": "titles", "type": "quantitative"},
        "y": {"field": "womens_winner", "type": "nominal", "sort": "-x"},
        "text": {"field": "titles", "type": "quantitative"}
      }
    }
  ]
}