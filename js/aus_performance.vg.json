{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Australian Players Reaching Quarterfinals or Better (2000–2026)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_qf_players.csv"
  },
  "mark": {"type": "bar", "color": "#00aeef"},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -45}},
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Australians in QF+",
      "axis": {"tickMinStep": 1}
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "count", "type": "quantitative", "title": "Australians in QF+"},
      {"field": "players", "type": "nominal", "title": "Players"}
    ]
  }
}