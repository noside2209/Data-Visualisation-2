{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 300,
  "title": "Number of Nations Represented at the Australian Open (2000–2026)",
  "data": {
    "url": "https://raw.githubusercontent.com/noside2209/Data-Visualisation-2/main/data/aus_open_atp.csv"
  },
  "transform": [
    {
      "aggregate": [{"op": "distinct", "field": "winner_ioc", "as": "nations"}],
      "groupby": ["tourney_date"]
    },
    {
      "calculate": "floor(datum.tourney_date / 10000)",
      "as": "year"
    }
  ],
  "mark": {"type": "line", "point": true, "color": "#00aeef"},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -45}},
    "y": {"field": "nations", "type": "quantitative", "title": "Number of Nations", "scale": {"domain": [0, 35]}},
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "nations", "type": "quantitative", "title": "Nations"}
    ]
  }
}